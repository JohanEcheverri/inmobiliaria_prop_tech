# Variables para conectar el backend local a MariaDB expuesto por Docker.
INMOBILIARIA_DB_URL=jdbc:mariadb://localhost:8081/inmobiliaria?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
INMOBILIARIA_DB_USER=inmobiliaria
INMOBILIARIA_DB_PASSWORD=inmobiliaria
INMOBILIARIA_DB_DRIVER=org.mariadb.jdbc.Driver
